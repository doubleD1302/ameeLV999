{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "livestock",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "phase": {
        "type": "string",
        "enum": [
          "P0",
          "P1",
          "P2",
          "P3"
        ]
      },
      "productItemId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "feedItemId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "cycleSeconds": {
        "type": "integer",
        "minimum": 1
      },
      "storageCap": {
        "type": "integer",
        "minimum": 1
      },
      "feedCapacity": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "id",
      "name",
      "phase",
      "productItemId",
      "feedItemId",
      "cycleSeconds",
      "storageCap",
      "feedCapacity"
    ],
    "additionalProperties": false
  }
}
