{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "time_cases",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "savedAtWallMs": {
        "type": "integer",
        "minimum": 0
      },
      "nowWallMs": {
        "type": "integer",
        "minimum": 0
      },
      "expectedCreditMs": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "id",
      "savedAtWallMs",
      "nowWallMs",
      "expectedCreditMs"
    ],
    "additionalProperties": false
  }
}
