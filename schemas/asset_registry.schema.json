{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset_registry",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "assetId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "phase": {
        "type": "string",
        "enum": [
          "P0",
          "P1",
          "P2",
          "P3"
        ]
      },
      "status": {
        "enum": [
          "planned",
          "generated",
          "approved",
          "rejected"
        ]
      },
      "relativeFile": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "styleVersion": {
        "type": "string",
        "minLength": 1
      },
      "promptPath": {
        "type": "string",
        "minLength": 1
      },
      "referenceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "sourceTool": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "generatedAt": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "rightsNote": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "targetWidth": {
        "type": "integer",
        "minimum": 1
      },
      "targetHeight": {
        "type": "integer",
        "minimum": 1
      },
      "alpha": {
        "type": "boolean"
      }
    },
    "required": [
      "assetId",
      "category",
      "phase",
      "status",
      "relativeFile",
      "styleVersion",
      "promptPath",
      "referenceIds",
      "sourceTool",
      "generatedAt",
      "rightsNote",
      "sha256",
      "targetWidth",
      "targetHeight",
      "alpha"
    ],
    "additionalProperties": false
  }
}
