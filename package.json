{
  "name": "blooming-home",
  "version": "0.1.0",
  "private": true,
  "description": "Blooming Home - Khu Vườn Đợi Nở",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "python tools/validate_pack.py && python tools/reference_checks.py"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.13.9",
    "eslint": "9.21.0",
    "terser": "5.39.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vite": "6.3.1",
    "vitest": "3.0.7"
  }
}
