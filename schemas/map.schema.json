{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "tileSize": {
      "type": "integer",
      "minimum": 1
    },
    "spawn": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      },
      "uniqueItems": true
    },
    "interactPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "targetZone": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "targetX": {
            "type": "integer",
            "minimum": 0
          },
          "targetY": {
            "type": "integer",
            "minimum": 0
          },
          "unlockFlag": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "x",
          "y",
          "targetZone",
          "targetX",
          "targetY",
          "unlockFlag"
        ],
        "additionalProperties": false
      }
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "unlockFlag": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "unlockFlag"
        ],
        "additionalProperties": false
      }
    },
    "debris": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "toolLevel": {
            "type": "integer",
            "minimum": 1
          },
          "blocksMovement": {
            "type": "boolean"
          },
          "yieldItems": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "toolLevel",
          "blocksMovement",
          "yieldItems"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "width",
    "height",
    "tileSize",
    "spawn",
    "blocked",
    "interactPoints",
    "portals",
    "plots",
    "debris"
  ],
  "additionalProperties": false
}
