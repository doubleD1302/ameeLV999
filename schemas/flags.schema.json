{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flags",
  "type": "object",
  "properties": {
    "initial": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "grantedByUpgrades": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "grantedByQuests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "planned": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "initial",
    "grantedByUpgrades",
    "grantedByQuests",
    "planned"
  ],
  "additionalProperties": false
}
