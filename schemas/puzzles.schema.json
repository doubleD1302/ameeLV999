{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "puzzles",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "engineVersion": {
            "const": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "instructionsKey": {
            "type": "string",
            "minLength": 1
          },
          "rewardCoins": {
            "type": "integer",
            "minimum": 0
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "engine": {
            "const": "memory"
          },
          "board": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "integer",
                "minimum": 1
              },
              "deck": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 4
              }
            },
            "required": [
              "columns",
              "deck"
            ],
            "additionalProperties": false
          },
          "solutionCertificate": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "id",
          "engineVersion",
          "phase",
          "tier",
          "seed",
          "instructionsKey",
          "rewardCoins",
          "hints",
          "engine",
          "board",
          "solutionCertificate"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "engineVersion": {
            "const": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "instructionsKey": {
            "type": "string",
            "minLength": 1
          },
          "rewardCoins": {
            "type": "integer",
            "minimum": 0
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "engine": {
            "const": "sliding"
          },
          "board": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 2,
                "maximum": 5
              },
              "tiles": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "size",
              "tiles"
            ],
            "additionalProperties": false
          },
          "solutionCertificate": {
            "type": "array",
            "items": {
              "enum": [
                "U",
                "D",
                "L",
                "R"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "engineVersion",
          "phase",
          "tier",
          "seed",
          "instructionsKey",
          "rewardCoins",
          "hints",
          "engine",
          "board",
          "solutionCertificate"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "engineVersion": {
            "const": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "instructionsKey": {
            "type": "string",
            "minLength": 1
          },
          "rewardCoins": {
            "type": "integer",
            "minimum": 0
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3
          },
          "engine": {
            "const": "pipe_rotation"
          },
          "board": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "cols": {
                "type": "integer",
                "minimum": 1
              },
              "basePorts": {
                "type": "array",
                "items": {
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    15
                  ]
                }
              },
              "rotations": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "locked": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              },
              "source": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "externalPort": {
                    "enum": [
                      1,
                      2,
                      4,
                      8
                    ]
                  }
                },
                "required": [
                  "index",
                  "externalPort"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "externalPort": {
                    "enum": [
                      1,
                      2,
                      4,
                      8
                    ]
                  }
                },
                "required": [
                  "index",
                  "externalPort"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rows",
              "cols",
              "basePorts",
              "rotations",
              "locked",
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          "solutionCertificate": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "required": [
          "id",
          "engineVersion",
          "phase",
          "tier",
          "seed",
          "instructionsKey",
          "rewardCoins",
          "hints",
          "engine",
          "board",
          "solutionCertificate"
        ],
        "additionalProperties": false
      }
    ]
  }
}
